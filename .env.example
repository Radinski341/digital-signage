# Infrastructure only. Restaurant content is configured in the CMS.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/restaurant"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/restaurant"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-at-least-32-random-bytes"
AWS_REGION="eu-north-1"
AWS_BUCKET_NAME="restaurant-media"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Stable HTTPS CDN origin, configured to serve only sites/*/media/*, never staging/*.
MEDIA_PUBLIC_BASE_URL="https://media.example.com"
# Only needed if a deployment database contains multiple sites.
# SITE_ID=""

# Optional server-only AI assistant. All requests use gpt-6-luna; no fallback model.
OPENAI_API_KEY=""
AI_USER_HOURLY_LIMIT="20"
AI_SITE_DAILY_LIMIT="100"
AI_MAX_OUTPUT_TOKENS="16000"

# Location maps use bundled Leaflet and public OpenStreetMap tiles; no keys are needed.

# Central website builder: budgets per explicitly started or resumed background continuation.
# The worker uses the same DATABASE_URL, OPENAI_API_KEY and site configuration as the web app.
AI_BUILDER_MAX_CALLS="3200"
AI_BUILDER_MAX_INPUT_TOKENS="50000000"
AI_BUILDER_MAX_OUTPUT_TOKENS="6400000"
